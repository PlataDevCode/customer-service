{
  "name": "customer-service",
  "version": "1.0.0",
  "main": "dist/main.js",
  "keywords": [],
  "author": "Alexander L.",
  "license": "ISC",
  "description": "Customer management API built with Node.js, TypeScript and Serverless Framework, following DDD and Hexagonal Architecture.",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.config.ts",
    "test:e2e": "cross-env NODE_ENV=test jest --config jest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.2.0",
    "prettier": "^3.3.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vendia/serverless-express": "^4.12.6",
    "express": "^5.2.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.2.1"
  }
}
